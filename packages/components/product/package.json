{
  "name": "@aio-ui/product",
  "version": "0.2.4",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css"
  ],
  "peerDependencies": {
    "@aio-ui/base": "^0.2.4",
    "@aio-ui/core": "^0.2.4"
  },
  "exports": {
    ".": {
