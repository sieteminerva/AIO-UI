{
  "name": "@aio-ui/form",
  "version": "0.2.5",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "adapters"
  ],
  "dependencies": {
    "@aio-ui/input": "^0.2.5"
  },
  "peerDependencies": {
    "@aio-ui/base": "^0.2.5",
    "@aio-ui/core": "^0.2.5",
    "@aio-ui/http-service": "^0.2.5",
    "@aio-ui/message": "^0.2.5",
    "@aio-ui/module-loader": "^0.2.5",
    "@aio-ui/utilities": "^0.2.5"
  },
  "exports": {
    ".": {
      "development": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Form.css": {
      "types": "./Form.css.d.ts",
      "default": "./Form.css"
    },
    "./FormMessages": {
      "development": "./FormMessages.ts",
      "types": "./dist/FormMessages.d.ts",
      "default": "./dist/FormMessages.js"
    },
    "./calculation-adapter": {
      "development": "./adapters/Calculation.ts",
      "types": "./dist/adapters/Calculation.d.ts",
      "default": "./dist/adapters/Calculation.js"
    },
    "./cascade-adapter": {
      "development": "./adapters/Cascade.ts",
      "types": "./dist/adapters/Cascade.d.ts",
      "default": "./dist/adapters/Cascade.js"
    },
    "./multistep-adapter": {
      "development": "./adapters/Multistep.ts",
      "types": "./dist/adapters/Multistep.d.ts",
      "default": "./dist/adapters/Multistep.js"
    },
    "./validation-adapter": {
      "development": "./adapters/Validation.ts",
      "types": "./dist/adapters/Validation.d.ts",
      "default": "./dist/adapters/Validation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
