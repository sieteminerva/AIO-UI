    "./events": {
      "types": "./dist/types/events.d.ts",
      "default": "./dist/types/events.js"
    },
    "./content": {
      "types": "./dist/types/content.d.ts",
      "default": "./dist/types/content.js"
    },
    "./page": {
      "types": "./dist/types/page.d.ts",
      "default": "./dist/types/page.js"
    },
    "./renderer": {
      "types": "./dist/types/renderer.d.ts",
