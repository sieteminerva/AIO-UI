{
  "name": "@aio-ui/id-address",
  "version": "0.2.4",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/id-address-adapter.d.ts",
      "default": "./dist/id-address-adapter.js"
    },
    "./adapter.native": {
      "types": "./dist/id-address-adapter.native.d.ts",
      "default": "./dist/id-address-adapter.native.js"
    },
    "./adapter.base": {
      "types": "./dist/id-address-adapter.base.d.ts",
      "default": "./dist/id-address-adapter.base.js"
    },
    "./adapter.aio": {
      "types": "./dist/id-address-adapter.aio.d.ts",
      "default": "./dist/id-address-adapter.aio.js"
    },
    "./form": {
      "types": "./dist/IdAddress.FormAdapter.d.ts",
      "default": "./dist/IdAddress.FormAdapter.js"
    },
    "./id-address.css": {
      "types": "./id-address.css.d.ts",
      "default": "./id-address.css"
    }
  },
  "peerDependenciesMeta": {
    "@aio-ui/form": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.4/aio-ui-core-0.2.4.tgz",
    "@aio-ui/form": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.4/aio-ui-form-0.2.4.tgz",
    "@aio-ui/http-service": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.4/aio-ui-http-service-0.2.4.tgz",
    "@aio-ui/module-loader": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.4/aio-ui-module-loader-0.2.4.tgz"
  }
}
