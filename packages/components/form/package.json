{
  "name": "@aio-ui/form",
  "version": "0.2.6",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "adapters"
  ],
  "dependencies": {
    "@aio-ui/input": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-input-0.2.6.tgz",
    "@aio-ui/base": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-base-0.2.6.tgz",
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-core-0.2.6.tgz",
    "@aio-ui/http-service": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-http-service-0.2.6.tgz",
    "@aio-ui/message": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-message-0.2.6.tgz",
    "@aio-ui/module-loader": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-module-loader-0.2.6.tgz",
    "@aio-ui/utilities": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-utilities-0.2.6.tgz"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Form.css": {
      "types": "./Form.css.d.ts",
      "default": "./Form.css"
    },
    "./FormMessages": {
      "types": "./dist/FormMessages.d.ts",
      "default": "./dist/FormMessages.js"
    },
    "./calculation-adapter": {
      "types": "./dist/adapters/Calculation.d.ts",
      "default": "./dist/adapters/Calculation.js"
    },
    "./cascade-adapter": {
      "types": "./dist/adapters/Cascade.d.ts",
      "default": "./dist/adapters/Cascade.js"
    },
    "./multistep-adapter": {
      "types": "./dist/adapters/Multistep.d.ts",
      "default": "./dist/adapters/Multistep.js"
    },
    "./validation-adapter": {
      "types": "./dist/adapters/Validation.d.ts",
      "default": "./dist/adapters/Validation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
