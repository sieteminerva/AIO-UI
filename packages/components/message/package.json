{
  "name": "@aio-ui/message",
  "version": "0.2.8",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "adapters"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Message.css": {
      "types": "./Message.css.d.ts",
      "default": "./Message.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aio-ui/base": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-base-0.2.8.tgz",
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-core-0.2.8.tgz",
    "@aio-ui/form": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-form-0.2.8.tgz",
    "@aio-ui/module-loader": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-module-loader-0.2.8.tgz"
  }
}
