{
  "name": "@aio-ui/input",
  "version": "0.2.6",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "Dropdown",
    "FileUploader",
    "InputControls",
    "InputPicker"
  ],
  "peerDependencies": {
    "@aio-ui/base": "^0.2.6",
    "@aio-ui/core": "^0.2.6",
    "@aio-ui/module-loader": "^0.2.6",
    "@aio-ui/utilities": "^0.2.6"
  },
  "exports": {
    ".": {
      "development": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Input.css": {
      "types": "./Input.css.d.ts",
      "default": "./Input.css"
    },
    "./dropdown": {
      "development": "./Dropdown/Dropdown.ts",
      "types": "./dist/Dropdown/Dropdown.d.ts",
      "default": "./dist/Dropdown/Dropdown.js"
    },
    "./Dropdown.css": {
      "types": "./Dropdown/Dropdown.css.d.ts",
      "default": "./Dropdown/Dropdown.css"
    },
    "./file-uploader": {
      "development": "./FileUploader/FileUploader.ts",
      "types": "./dist/FileUploader/FileUploader.d.ts",
      "default": "./dist/FileUploader/FileUploader.js"
    },
    "./FileUploader.css": {
      "types": "./FileUploader/FileUploader.css.d.ts",
      "default": "./FileUploader/FileUploader.css"
    },
    "./controls": {
      "development": "./InputControls/InputControls.ts",
      "types": "./dist/InputControls/InputControls.d.ts",
      "default": "./dist/InputControls/InputControls.js"
    },
    "./InputControls.css": {
      "types": "./InputControls/InputControls.css.d.ts",
      "default": "./InputControls/InputControls.css"
    },
    "./picker": {
      "development": "./InputPicker/InputPicker.ts",
      "types": "./dist/InputPicker/InputPicker.d.ts",
      "default": "./dist/InputPicker/InputPicker.js"
    },
    "./InputPicker.css": {
      "types": "./InputPicker/InputPicker.css.d.ts",
      "default": "./InputPicker/InputPicker.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}