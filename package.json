{
  "name": "aio-ui",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/components/*",
    "packages/modules/*",
    "packages/themes/*",
    "packages/kits/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aio-ui/example-gallery run dev",
    "dev:demo": "npm --workspace @aio-ui/example-demo run dev",
    "build": "npm --workspace @aio-ui/example-gallery run build",
    "build:demo": "npm --workspace @aio-ui/example-demo run build",
    "preview": "npm --workspace @aio-ui/example-gallery run preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "tsc --noEmit -p examples/demo/tsconfig.json && tsc --noEmit -p examples/gallery/tsconfig.json",
    "check:bounds": "node scripts/bounds.mjs",
    "check:edges": "node scripts/edges.mjs --check",
    "check:kit": "node scripts/build-renderer-kit.mjs --check",
    "check:bundle": "node scripts/bundle-probe.mjs",
    "version:report": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "release:plan": "node scripts/release.mjs",
    "publish:releases": "node scripts/publish-releases.mjs",
    "publish:cdn": "node scripts/publish-cdn.mjs",
    "publish:assets": "node scripts/publish-release-assets.mjs",
    "new:component": "node scripts/new-component.mjs",
    "check": "npm run typecheck && npm run typecheck:examples && npm run check:bounds && npm run check:edges && npm run check:kit && npm run check:bundle && npm run check:api && npm run check:catalogue && npm run version:check",
    "verify": "npm run check && npm run test",
    "verify:pkgs": "npm run build:pkgs && npm run verify && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pkgs": "node scripts/build-pack.mjs --build",
    "build:bundle": "node scripts/build-bundle.mjs",
    "check:api": "node scripts/api.mjs --check",
    "check:catalogue": "node scripts/catalogue.mjs --check",
    "check:live": "node scripts/release-doc.mjs --probe",
    "catalogue": "node scripts/catalogue.mjs",
    "catalogue:apply": "node scripts/catalogue.mjs --apply",
    "session": "node scripts/session.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
