{
  "name": "@aio-ui/id-address",
  "version": "0.2.8",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./IdAddress.css": {
      "types": "./IdAddress.css.d.ts",
      "default": "./IdAddress.css"
    }
  },
  "peerDependenciesMeta": {
    "@aio-ui/form": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-core-0.2.8.tgz",
    "@aio-ui/form": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-form-0.2.8.tgz",
    "@aio-ui/http-service": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-http-service-0.2.8.tgz",
    "@aio-ui/module-loader": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.8/aio-ui-module-loader-0.2.8.tgz"
  }
}
