{
  "name": "@aio-ui/core",
  "version": "0.2.4",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@aio-ui/utilities": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.4/aio-ui-utilities-0.2.4.tgz",
    "@aio-ui/styles": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.4/aio-ui-styles-0.2.4.tgz"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
