{
  "name": "@aio-ui/masonry",
  "version": "0.2.6",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css"
  ],
  "dependencies": {
    "@aio-ui/utilities": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-utilities-0.2.6.tgz",
    "@aio-ui/base": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-base-0.2.6.tgz",
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.6/aio-ui-core-0.2.6.tgz"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Masonry.css": {
      "types": "./Masonry.css.d.ts",
      "default": "./Masonry.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
