{
  "name": "@aio-ui/form",
  "version": "0.2.3",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "adapters"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/FormAdapters.d.ts",
      "default": "./dist/FormAdapters.js"
    },
    "./Form.css": "./Form.css",
    "./FormLayout": {
      "types": "./dist/FormLayout.d.ts",
      "default": "./dist/FormLayout.js"
    },
    "./FormMessages": {
      "types": "./dist/FormMessages.d.ts",
      "default": "./dist/FormMessages.js"
    },
    "./FormModuleTypes": {
      "types": "./dist/FormModuleTypes.d.ts",
      "default": "./dist/FormModuleTypes.js"
    },
    "./FormRegistry": {
      "types": "./dist/FormRegistry.d.ts",
      "default": "./dist/FormRegistry.js"
    },
    "./Input.FormAdapter": {
      "types": "./dist/Input.FormAdapter.d.ts",
      "default": "./dist/Input.FormAdapter.js"
    },
    "./calculation-adapter": {
      "types": "./dist/adapters/Calculation.d.ts",
      "default": "./dist/adapters/Calculation.js"
    },
    "./cascade-adapter": {
      "types": "./dist/adapters/Cascade.d.ts",
      "default": "./dist/adapters/Cascade.js"
    },
    "./multistep-adapter": {
      "types": "./dist/adapters/Multistep.d.ts",
      "default": "./dist/adapters/Multistep.js"
    },
    "./validation-adapter": {
      "types": "./dist/adapters/Validation.d.ts",
      "default": "./dist/adapters/Validation.js"
    }
  },
  "dependencies": {
    "@aio-ui/input": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-input-0.2.3.tgz",
    "@aio-ui/base": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-base-0.2.3.tgz",
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-core-0.2.3.tgz",
    "@aio-ui/http-service": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-http-service-0.2.3.tgz",
    "@aio-ui/message": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-message-0.2.3.tgz",
    "@aio-ui/module-loader": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-module-loader-0.2.3.tgz",
    "@aio-ui/utilities": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-utilities-0.2.3.tgz"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
