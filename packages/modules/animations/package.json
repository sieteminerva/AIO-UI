{
  "name": "@aio-ui/animations",
  "version": "0.2.3",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "behaviours",
    "canvas"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Animations.css": "./Animations.css",
    "./behaviours": {
      "types": "./dist/behaviours/registry.d.ts",
      "default": "./dist/behaviours/registry.js"
    },
    "./behaviours/*": {
      "types": "./dist/behaviours/*.d.ts",
      "default": "./dist/behaviours/*.js"
    },
    "./canvas/*": {
      "types": "./dist/canvas/*.d.ts",
      "default": "./dist/canvas/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-core-0.2.3.tgz",
    "@aio-ui/utilities": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.3/aio-ui-utilities-0.2.3.tgz"
  }
}
