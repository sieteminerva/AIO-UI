{
  "name": "@aio-ui/input",
  "version": "0.2.7",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "Dropdown",
    "FileUploader",
    "InputControls",
    "InputPicker"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Input.css": {
      "types": "./Input.css.d.ts",
      "default": "./Input.css"
    },
    "./dropdown": {
      "types": "./dist/Dropdown/Dropdown.d.ts",
      "default": "./dist/Dropdown/Dropdown.js"
    },
    "./Dropdown.css": {
      "types": "./Dropdown/Dropdown.css.d.ts",
      "default": "./Dropdown/Dropdown.css"
    },
    "./file-uploader": {
      "types": "./dist/FileUploader/FileUploader.d.ts",
      "default": "./dist/FileUploader/FileUploader.js"
    },
    "./FileUploader.css": {
      "types": "./FileUploader/FileUploader.css.d.ts",
      "default": "./FileUploader/FileUploader.css"
    },
    "./controls": {
      "types": "./dist/InputControls/InputControls.d.ts",
      "default": "./dist/InputControls/InputControls.js"
    },
    "./InputControls.css": {
      "types": "./InputControls/InputControls.css.d.ts",
      "default": "./InputControls/InputControls.css"
    },
    "./picker": {
      "types": "./dist/InputPicker/InputPicker.d.ts",
      "default": "./dist/InputPicker/InputPicker.js"
    },
    "./InputPicker.css": {
      "types": "./InputPicker/InputPicker.css.d.ts",
      "default": "./InputPicker/InputPicker.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aio-ui/base": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.7/aio-ui-base-0.2.7.tgz",
    "@aio-ui/core": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.7/aio-ui-core-0.2.7.tgz",
    "@aio-ui/module-loader": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.7/aio-ui-module-loader-0.2.7.tgz",
    "@aio-ui/utilities": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.7/aio-ui-utilities-0.2.7.tgz"
  }
}
