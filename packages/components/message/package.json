{
  "name": "@aio-ui/message",
  "version": "0.2.2",
  "type": "module",
  "files": [
    "dist",
    "*.ts",
    "*.css",
    "adapters"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Message.css": "./Message.css",
    "./adapters/FormAdapter": {
      "types": "./dist/adapters/FormAdapter.d.ts",
      "default": "./dist/adapters/FormAdapter.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aio-ui/base": "0.2.2",
    "@aio-ui/core": "0.2.2",
    "@aio-ui/form": "0.2.2",
    "@aio-ui/module-loader": "0.2.2"
  },
  "bundledDependencies": [
    "@aio-ui/base",
    "@aio-ui/core",
    "@aio-ui/form",
    "@aio-ui/module-loader"
  ]
}
