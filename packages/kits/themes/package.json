{
  "name": "@aio-ui/themes",
  "version": "0.2.9",
  "type": "module",
  "description": "Aggregated public surface for themes.",
  "files": [
    "dist",
    "*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aio-ui/theme-cyberpunk": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.9/aio-ui-theme-cyberpunk-0.2.9.tgz",
    "@aio-ui/theme-default": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.9/aio-ui-theme-default-0.2.9.tgz",
    "@aio-ui/theme-horizontal": "https://github.com/sieteminerva/AIO-UI/raw/releases/v0.2.9/aio-ui-theme-horizontal-0.2.9.tgz"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  }
}
