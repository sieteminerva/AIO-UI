{
  // Shared compiler options for the monorepo. Every package and the example
  // application extends this file; only `include` / `exclude` differ per project.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /**
     * Resolve the `development` condition that every package `exports` map puts first, so tsc
     * type-checks against `src/**` instead of `dist/**\/*.d.ts`. Two consequences, both wanted:
     *
     * - `typecheck` no longer needs a build first (it used to read stale declarations, which is
     *   what produced "Subsequent property declarations must have the same type" after a global
     *   type change),
     * - a stale `dist/` can never make the gate lie, because the gate never reads it.
     *
     * Vitest and Vite already resolve this condition, so the whole toolchain now reads one source.
     */
    "customConditions": ["development"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
